Subject: [PATCH] Add missing C++ standard library includes

ARGoS3 was written against older compilers that pulled these headers in
transitively. GCC 11+ and Clang 13+ (libc++) require them explicitly:
  <algorithm>   std::sort, std::find, std::remove_if, std::min_element
  <functional>  std::less<T*>, std::bind, std::function
  <iterator>    std::back_inserter
  <memory>      std::shared_ptr, std::make_shared, std::unique_ptr
  <cstdint>     uint8_t, uint32_t, int32_t

diff --git a/src/core/control_interface/ci_actuator.h b/src/core/control_interface/ci_actuator.h
index 1f96c17..2eabb19 100644
--- a/src/core/control_interface/ci_actuator.h
+++ b/src/core/control_interface/ci_actuator.h
@@ -13,6 +13,7 @@ namespace argos {
    class CCI_Actuator;
 }
 
+#include <functional>
 #include <argos3/core/config.h>
 #include <argos3/core/utility/datatypes/datatypes.h>
 #include <argos3/core/utility/configuration/base_configurable_resource.h>
